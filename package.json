{
  "name": "medstudy-atlas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker:documents": "tsx --conditions=react-server --env-file=.env.local src/workers/documents-worker.ts",
    "worker:study-packs": "tsx --conditions=react-server --env-file=.env.local src/workers/study-packs-worker.ts",
    "ai:benchmark:study-pack": "tsx --conditions=react-server --env-file=.env.local src/benchmarks/study-pack-benchmark.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > src/types/database.ts && prettier --write src/types/database.ts",
    "db:test": "supabase test db",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm db:test",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm db:test && pnpm build"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.53",
    "@base-ui/react": "1.8.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "ai": "7.0.107",
    "class-variance-authority": "0.7.1",
    "cn": "0.3.0",
    "lucide-react": "1.47.0",
    "next": "16.3.5",
    "next-themes": "0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "4.21.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "jsdom": "30.1.0",
    "prettier": "3.9.8",
    "supabase": "2.117.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.19.4",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "packageManager": "pnpm@11.19.0"
}
